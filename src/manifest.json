{
  "manifest_version": 3,
  "name": "Prune: Dead Link & Duplicate Bookmark Cleaner",
  "short_name": "Prune",
  "version": "0.1.2",
  "description": "Find dead links, duplicate bookmarks and empty folders, review them, and clean up with one-click undo. Free, no ads, no tracking.",
  "browser_specific_settings": {
    "gecko": {
      "id": "prune-bookmark-cleaner@c4rcer",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["bookmarks", "storage"],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Prune: clean up bookmarks",
    "default_icon": { "48": "icons/icon.svg", "96": "icons/icon.svg" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "options_ui": { "page": "app/app.html", "open_in_tab": true },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" }
}
